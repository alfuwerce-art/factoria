{
  "id": "BASE_BODY_V1",
  "asset_type": "BASE_BODY",
  "allowed_views": [
    "FRONT",
    "BACK",
    "LEFT",
    "RIGHT"
  ],
  "positive": "(single adult human technical voxel mannequin, full body:1.15), (strict T-pose with both arms rigid, straight and horizontal at shoulder height:1.25), mirror-symmetric stance, straight legs and separated feet flat on one baseline, whole square hands and integral block feet visible, centred full-height silhouette, (featureless blank rectangular head with a flat forehead and a simple visible neck:1.2), (one continuous desaturated neutral-grey matte material across head, torso, hands and feet:1.2), minimal large joined cuboid volumes, flat planes, a few large stepped edges, plain neutral grey background, simplified non-anatomical geometry and smooth monochrome areas",
  "negative": "(clothes, costume, shirt, trousers, underwear, shorts, armor, shoes, boots, gloves, belts, seams, collar, cuffs, straps, socket caps:1.25), weapon, accessories, (eyes, pupils, eyebrows, eyelashes, nose, lips, mouth, expression, hair, beard, mustache, headwear:1.25), other face details, anatomy definition, muscles, skin texture, anatomical markings, gendered chest detailing, small cubes, clutter, movable attachments, extra limbs, A-pose, bent wrists, sloped arms, bent knees, hidden hands, hidden feet, ground-plane perspective, asymmetric silhouette",
  "graph": {
    "checkpoint": {
      "class_type": "CheckpointLoaderSimple",
      "_meta": {
        "title": "DreamShaper XL Turbo v2.1"
      },
      "inputs": {
        "ckpt_name": "$checkpoint"
      }
    },
    "lora": {
      "class_type": "LoraLoader",
      "_meta": {
        "title": "ral-vxl (experimental only)"
      },
      "inputs": {
        "model": [
          "checkpoint",
          0
        ],
        "clip": [
          "checkpoint",
          1
        ],
        "lora_name": "$lora",
        "strength_model": "$strength_model",
        "strength_clip": "$strength_clip"
      }
    },
    "positive": {
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "Style + profile + requested module + view"
      },
      "inputs": {
        "clip": [
          "lora",
          1
        ],
        "text": "$positive_prompt"
      }
    },
    "negative": {
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "Style and module exclusions"
      },
      "inputs": {
        "clip": [
          "lora",
          1
        ],
        "text": "$negative_prompt"
      }
    },
    "geometry_guide": {
      "class_type": "LoadImage",
      "_meta": {
        "title": "Same-object, same-view geometry guide"
      },
      "inputs": {
        "image": "$geometry_guide"
      }
    },
    "guide_scale": {
      "class_type": "ImageScale",
      "_meta": {
        "title": "Fixed framing (no crop)"
      },
      "inputs": {
        "image": [
          "geometry_guide",
          0
        ],
        "upscale_method": "$resize_method",
        "width": "$width",
        "height": "$height",
        "crop": "$crop"
      }
    },
    "edges": {
      "class_type": "Canny",
      "_meta": {
        "title": "View-specific contours"
      },
      "inputs": {
        "image": [
          "guide_scale",
          0
        ],
        "low_threshold": "$low_threshold",
        "high_threshold": "$high_threshold"
      }
    },
    "controlnet": {
      "class_type": "ControlNetLoader",
      "_meta": {
        "title": "ControlNet Union SDXL"
      },
      "inputs": {
        "control_net_name": "$controlnet"
      }
    },
    "canny_mode": {
      "class_type": "SetUnionControlNetType",
      "_meta": {
        "title": "Canny / lineart union type"
      },
      "inputs": {
        "control_net": [
          "controlnet",
          0
        ],
        "type": "$union_type"
      }
    },
    "guide_conditioning": {
      "class_type": "ControlNetApplyAdvanced",
      "_meta": {
        "title": "Geometry conditioning"
      },
      "inputs": {
        "positive": [
          "positive",
          0
        ],
        "negative": [
          "negative",
          0
        ],
        "control_net": [
          "canny_mode",
          0
        ],
        "image": [
          "edges",
          0
        ],
        "strength": "$control_strength",
        "start_percent": "$control_start",
        "end_percent": "$control_end"
      }
    },
    "sampler": {
      "class_type": "KSampler",
      "_meta": {
        "title": "One controlled view"
      },
      "inputs": {
        "model": [
          "lora",
          0
        ],
        "positive": [
          "guide_conditioning",
          0
        ],
        "negative": [
          "guide_conditioning",
          1
        ],
        "latent_image": [
          "latent",
          0
        ],
        "seed": "$seed",
        "steps": "$steps",
        "cfg": "$cfg",
        "sampler_name": "$sampler_name",
        "scheduler": "$scheduler",
        "denoise": "$denoise"
      }
    },
    "decode": {
      "class_type": "VAEDecode",
      "_meta": {
        "title": "Decoded RGB view"
      },
      "inputs": {
        "samples": [
          "sampler",
          0
        ],
        "vae": [
          "checkpoint",
          2
        ]
      }
    },
    "latent": {
      "class_type": "EmptyLatentImage",
      "_meta": {
        "title": "Single frame"
      },
      "inputs": {
        "width": "$width",
        "height": "$height",
        "batch_size": "$batch_size"
      }
    },
    "save_reference": {
      "class_type": "SaveImage",
      "_meta": {
        "title": "Base body view"
      },
      "inputs": {
        "images": [
          "decode",
          0
        ],
        "filename_prefix": "$reference_prefix"
      }
    }
  }
}
